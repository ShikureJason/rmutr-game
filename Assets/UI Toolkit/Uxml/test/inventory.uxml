<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/USS/Test/Inventory.uss?fileID=7433441132597879392&amp;guid=e8c40b45a1f4d424d8c73b7408b602c4&amp;type=3#Inventory" />
    <ui:VisualElement name="inventory" style="flex-direction: row-reverse;">
        <ui:VisualElement name="container_inventory" style="width: 416px; height: 556px; position: absolute; top: 200px; left: 0; right: 100px; flex-direction: column; align-items: stretch; justify-content: flex-start; background-color: rgba(255, 81, 81, 0.81);">
            <ui:VisualElement name="slot_inventory" class="inventory-slot-container" style="width: 100%; height: 100%; max-width: 100%; max-height: 100%; min-width: 100%; min-height: 100%; flex-direction: row; flex-wrap: wrap;">
                <ui:VisualElement class="inventory-slotContainer" style="display: none; visibility: hidden; overflow: hidden;">
                    <ui:VisualElement class="inventory-slotIcon" style="background-image: url(&apos;project://database/Assets/Materials/Sprite/Inventory/Item/syndicate.png?fileID=2800000&amp;guid=515d219f1a2df0449968a34d210a81bd&amp;type=3#syndicate&apos;); width: 128px; height: 128px;" />
                    <ui:VisualElement class="inventory-slotItemCount">
                        <ui:Label text="Label" display-tooltip-when-elided="true" class="inventory-slotItemCountText" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
