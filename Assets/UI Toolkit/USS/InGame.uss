.inventory-slot-container {
    overflow-x: auto;
}

.inventory-slotIcon {
    flex-shrink: 0;
    flex-grow: 1;
    padding: 15px;
    width: 100%;
    height: 100%;
}

.inventory-slotContainer {
    width: 128px;
    height: 128px;
    margin: 5px;
    border-left-color: rgb(48, 48, 48);
    border-right-color: rgb(48, 48, 48);
    border-top-color: rgb(48, 48, 48);
    border-bottom-color: rgb(48, 48, 48);
    background-color: rgb(9, 19, 21);
    background-image: url('project://database/Assets/Materials/Sprite/Inventory/ItemSlotBackground.png?fileID=2800000&guid=e0625b43d41fb794281ea075c61262e6&type=3#ItemSlotBackground');
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    display: flex;
}

.inventory-slotItemCount {
    width: 30px;
    height: 30px;
    background-color: rgb(255, 0, 0);
    overflow: visible;
    bottom: 3px;
    right: auto;
    border-top-left-radius: 15px;
    border-bottom-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    left: 96px;
    align-items: center;
    justify-content: space-around;
    z-index: 100;
    position: absolute;
}

.inventory-slotItemCountText {
    width: 25px;
    height: 25px;
    -unity-text-align: middle-center;
    align-items: stretch;
    font-size: 15px;
    color: rgb(0, 0, 0);
    right: auto;
    left: auto;
    overflow: hidden;
}

.interract-image {
}

.ui-interract-text {
}

.pauseMenu-Container {
    align-items: center;
    justify-content: space-around;
    background-color: rgba(0, 0, 0, 0.39);
}

.pauseMenu-menuContainer {
    width: 800px;
    height: 1000px;
    justify-content: flex-start;
}

.pauseMenu-buttonMenu {
    width: auto;
    height: 75px;
    border-top-width: 0;
    margin-top: 15px;
    margin-bottom: 15px;
}

.pauseMenu-buttonSetting {
    width: 370px;
    height: 70s;
    margin-top: 30px;
    transition-duration: 0s;
    background-color: rgb(255, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-top-left-radius: 20px;
    border-bottom-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
}

.pauseMenu-buttonSetting:hover {
    scale: 1.1 1.1;
    transition-duration: 0.1s;
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 20px;
    border-bottom-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    -unity-background-image-tint-color: rgb(255, 0, 0);
    border-left-color: rgb(255, 0, 0);
    border-right-color: rgb(255, 0, 0);
    border-top-color: rgb(255, 0, 0);
    border-bottom-color: rgb(255, 0, 0);
    color: rgb(255, 0, 0);
}

.loadScreen-container {
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
}

.loadScreen-text {
    font-size: 200px;
}
